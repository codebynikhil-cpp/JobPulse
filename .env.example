# ==============================================================================
# JobPulse — Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (PostgreSQL 17)
# ------------------------------------------------------------------------------
POSTGRES_USER=jobpulse
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=jobpulse
DATABASE_URL=postgresql+psycopg://jobpulse:replace-with-random-local-password@postgres:5432/jobpulse

# ------------------------------------------------------------------------------
# Application & Security Settings
# ------------------------------------------------------------------------------
# Fully qualified origin of the frontend application (checked for CSRF defense on mutations)
APP_ORIGIN=http://localhost:3000

# Set COOKIE_SECURE=true in production with HTTPS (enforces __Host- cookie prefix)
COOKIE_SECURE=false

# Trust X-Forwarded-For reverse-proxy header for client IP rate limiting (set true ONLY behind trusted reverse proxy)
TRUST_FORWARDED_FOR=false

# Authentication session duration in hours
SESSION_HOURS=168

# Consecutive login failure threshold before IP rate limiting engages
AUTH_FAILURE_LIMIT=5

# Rate limit evaluation window in seconds (15 minutes)
AUTH_WINDOW_SECONDS=900

# ------------------------------------------------------------------------------
# Monitoring Worker Configuration
# ------------------------------------------------------------------------------
# Scheduler polling interval in seconds
MONITOR_TICK_SECONDS=10

# Maximum execution time allocated per job source before timeout cancellation
MONITOR_SOURCE_TIMEOUT_SECONDS=90

# Maximum due sources processed per scheduler cycle
MONITOR_SOURCE_BATCH_SIZE=100

# Batch size for evaluating user profiles against new/updated jobs
MONITOR_PROFILE_BATCH_SIZE=100

# Batch size for processing discovered canonical jobs
MONITOR_JOB_BATCH_SIZE=100

# Threshold fraction of disappearing jobs triggering anomaly safety hold
MONITOR_ANOMALY_DROP_FRACTION=0.5

# Consecutive source failures before auto-deactivating source to prevent spamming
MONITOR_PAUSE_AFTER_FAILURES=5

# ------------------------------------------------------------------------------
# Browser Automation Infrastructure (Playwright / Browserbase)
# ------------------------------------------------------------------------------
# Browser execution provider: "local" (Chromium container) or "browserbase"
BROWSER_PROVIDER=local
BROWSER_MAX_SESSIONS=1

# Optional Browserbase credentials (only needed if BROWSER_PROVIDER=browserbase)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ------------------------------------------------------------------------------
# Notification Outbox & Delivery Configuration
# ------------------------------------------------------------------------------
# Master switch for the notification pipeline
NOTIFICATIONS_ENABLED=true

# Policy for re-notifying users on changed job postings:
# "material" (significant updates), "newly_relevant" (only if score rises above threshold), "off"
NOTIFICATION_CHANGED_POLICY=material

# Maximum delivery attempts before transitioning to permanently_failed
NOTIFICATION_MAX_ATTEMPTS=5

# Exponential backoff base in seconds (base * 2^(attempt-1))
NOTIFICATION_RETRY_BASE_SECONDS=60

# Maximum retry backoff cap in seconds (1 hour)
NOTIFICATION_RETRY_CAP_SECONDS=3600

# Worker lease duration for SELECT FOR UPDATE SKIP LOCKED claims (seconds)
NOTIFICATION_LEASE_SECONDS=120

# Notification worker loop tick interval in seconds
NOTIFICATION_TICK_SECONDS=10

# Batch size for claiming outbox records
NOTIFICATION_BATCH_SIZE=50

# ------------------------------------------------------------------------------
# Email Provider (Resend)
# ------------------------------------------------------------------------------
# Email delivery provider: "disabled" (sink suppresses sends) or "resend"
EMAIL_PROVIDER=disabled

# Resend API key (e.g. re_123456789) - required when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Verified sender email address (e.g. JobPulse <notifications@yourdomain.com>)
EMAIL_FROM=
